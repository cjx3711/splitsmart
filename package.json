{
  "name": "splitsmart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.21",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"yarn dev:api\" \"yarn dev:web\"",
    "dev:api": "node --env-file=.env --watch --experimental-strip-types src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "yarn build:web && yarn build:api",
    "build:api": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node dist/server.js",
    "db:migrate": "node --env-file=.env --experimental-strip-types src/db/migrate.ts",
    "db:seed": "node --env-file=.env --experimental-strip-types src/db/seed.ts",
    "seed:splitwise": "node --env-file=.env --experimental-strip-types scripts/seed-from-splitwise.ts",
    "db:codegen": "kysely-codegen --dialect sqlite --url ./data/splitsmart.db --out-file src/db/types.ts",
    "db:check": "node --env-file=.env --experimental-strip-types scripts/check-invariants.ts",
    "verify:user": "node --env-file=.env --experimental-strip-types scripts/verify-user.ts",
    "seed:demo": "node --env-file=.env --experimental-strip-types scripts/seed-demo.ts",
    "icons": "node --experimental-strip-types scripts/generate-icons.ts",
    "db:reset": "rm -f data/splitsmart.db data/splitsmart.db-wal data/splitsmart.db-shm && yarn db:migrate && yarn db:seed",
    "export:splitwise": "node --env-file=.env --experimental-strip-types scripts/export-splitwise.ts",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\" \"web/src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint src web/src scripts",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "smoke:reset": "rm -f data/smoke.db data/smoke.db-wal data/smoke.db-shm && DATABASE_PATH=./data/smoke.db APP_ORIGIN=http://localhost:5644 yarn db:migrate && DATABASE_PATH=./data/smoke.db APP_ORIGIN=http://localhost:5644 yarn db:seed && DATABASE_PATH=./data/smoke.db APP_ORIGIN=http://localhost:5644 SEED_TODAY=2026-06-01 yarn seed:demo",
    "smoke:server": "DATABASE_PATH=./data/smoke.db DISABLE_RECURRING_SCHEDULER=true ADMIN_EMAILS=test@example.com PORT=5645 API_PORT=5645 WEB_PORT=5644 APP_ORIGIN=http://localhost:5644 concurrently -n smoke-api,smoke-web -c blue,magenta \"node --env-file=.env --experimental-strip-types src/server.ts\" \"vite --config web/vite.config.ts\"",
    "smoke:check": "DATABASE_PATH=./data/smoke.db node --env-file=.env --experimental-strip-types scripts/smoke-seed-check.ts && DATABASE_PATH=./data/smoke.db yarn db:check",
    "smoke:new": "node --experimental-strip-types scripts/smoke-run.ts",
    "smoke:install": "playwright install chromium",
    "smoke:baseline": "node --experimental-strip-types scripts/smoke-capture.ts",
    "smoke:capture": "node --experimental-strip-types scripts/smoke-capture.ts",
    "smoke:compare": "node --experimental-strip-types scripts/smoke-compare.ts",
    "smoke:flows": "node --experimental-strip-types scripts/smoke-flows.ts",
    "smoke:snapshot": "node --experimental-strip-types scripts/smoke-snapshot.ts",
    "smoke:report": "node --experimental-strip-types scripts/smoke-report.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/lib-storage": "^3.1116.0",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.1",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.6.14",
    "kysely": "^0.27.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "kysely-codegen": "^0.17.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
