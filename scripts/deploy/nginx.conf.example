# Reverse proxy for a SplitSmart deploy, terminating TLS in front of the
# container's published port (DEPLOY_PORT in .env.deploy, 5545 by default).
#
# Copy to your server's nginx sites-available, replace YOUR_DOMAIN and
# YOUR_PORT, symlink into sites-enabled, then obtain a cert. This file is a
# starting point, not something deploy.sh manages — TLS and DNS are one-time
# setup, not part of the deploy cycle.
#
# One common flow with certbot's nginx plugin:
#   1. Start with just the port-80 block below (comment out the 443 block,
#      since the cert files don't exist yet).
#   2. nginx -t && systemctl reload nginx
#   3. certbot --nginx -d YOUR_DOMAIN
#      This edits the file in place to add the 443 block and the redirect,
#      so you may not need to hand-write the block below at all — it's
#      included so you can see what certbot will produce, and to have
#      something to restore from if the automatic edit is ever lost.

server {
  listen 443 ssl;
  server_name YOUR_DOMAIN;

  location / {
    proxy_pass http://localhost:YOUR_PORT;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_hide_header X-Powered-By;
  }

  ssl_certificate /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
  listen 80;
  server_name YOUR_DOMAIN;
  return 301 https://$host$request_uri;
}
