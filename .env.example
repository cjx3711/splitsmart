# Copy to .env and fill in. Never commit .env.

# --- Core ---
NODE_ENV=development
PORT=5545

# Where the SQLite file lives. In Docker this should point at a mounted volume.
DATABASE_PATH=./data/splitsmart.db

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing this logs everybody out.
SESSION_SECRET=

# Public origin, used to build invite links (no trailing slash).
APP_ORIGIN=http://localhost:5545

# --- Splitwise import (only needed while running scripts/export-splitwise.ts) ---
# Personal API key from https://secure.splitwise.com/apps
SPLITWISE_API_KEY=

# --- Email (NOT WIRED UP YET — see docs/PLAN.md phase 4) ---
# When implemented, absence of this var must disable email sending silently
# rather than crashing at boot.
# POSTMARK_SERVER_TOKEN=
# POSTMARK_FROM_ADDRESS=
