# Copy to .env and fill in. Never commit .env.

# --- Core ---
NODE_ENV=development
PORT=5445

# Where the SQLite file lives. In Docker this should point at a mounted volume.
DATABASE_PATH=./data/splitsmart.db

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing this logs everybody out.
SESSION_SECRET=

# Public origin, used to build guest links, email links, and Open Graph URLs
# (no trailing slash).
# In dev this is VITE's port, not the API's: a guest link is opened in a
# browser, and the browser talks to the frontend, which proxies /api through.
APP_ORIGIN=http://localhost:5444

# --- Splitwise ---
# There is deliberately no SPLITWISE_API_KEY here. Importing is per-user, so the
# key belongs to the person doing it: they paste it into the wizard at /import,
# it is used for that request, and it is never written to the database.
#
# The only reason this base URL is configurable is testing: point it at a fake
# Splitwise on localhost to drive the whole import without a real account.
# Leave it unset in production.
# SPLITWISE_API_BASE=https://secure.splitwise.com/api/v3.0
#
# scripts/export-splitwise.ts is a separate, optional raw-JSON backup tool. It
# reads SPLITWISE_API_KEY from the shell, not from this file:
#   SPLITWISE_API_KEY=... yarn export:splitwise

# --- Email ---
# Configure ONE provider. A complete pair is the API credential plus a from
# address. Setting both Resend and Postmark complete pairs is a boot error.
# If neither is set, sending degrades to a console log; the server still boots,
# registration still works, and the verification link is printed to the
# terminal so you can complete the flow locally without a mail provider.
#
# From-address may be a bare email or `Name <email>`. It must be a verified
# sender on whichever provider you pick.

# Resend (https://resend.com): API Keys in the dashboard. Their test sender
# onboarding@resend.dev only delivers to the account's own inbox.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# Postmark: Servers > your server > API Tokens. Leave blank if you use Resend.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_ADDRESS=
# Transactional mail must not go out on a broadcast stream.
POSTMARK_MESSAGE_STREAM=outbound

# When false (default), signup returns the verification URL to the client so
# you can finish creating an account without a mail provider. Unverified
# existing accounts can still log in; the UI shows a banner.
#
# When true, that URL is emailed and omitted from the API response, and login
# is BLOCKED until the address is confirmed. Think before enabling on a
# self-hosted box: combined with a broken mail config it locks everyone out.
# The escape hatch is `yarn verify:user -- you@example.com`.
EMAIL_VERIFICATION_REQUIRED=false

# --- Admin ---
# Comma-separated emails that may open /app/admin (usage counts only). Empty
# means nobody. Compared case-insensitively against users.email.
# ADMIN_EMAILS=you@example.com

# --- Daily database backup to S3-compatible storage ---
# Kill switch that leaves the credentials in place. Defaults to true in
# production and false everywhere else, so `yarn dev` never vacuums your
# working database. A missing or partial set of the three required vars
# disables the feature and is shown on /app/admin/backups; it never
# crashes boot. BACKUP_* is read by src/backup/config.ts, not env.ts.
# BACKUP_ENABLED=false

# Required. Without all three the feature stays unconfigured and does nothing.
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=

# Tigris global endpoint. Paste whatever the console shows.
# BACKUP_S3_ENDPOINT=https://t3.storage.dev
# Tigris ignores the region, but the AWS SDK requires a non-empty one.
# BACKUP_S3_REGION=auto
# Only needed for a local MinIO target.
# BACKUP_S3_FORCE_PATH_STYLE=false

# Key prefix. Normalised to no leading slash and exactly one trailing slash.
# Setting it to empty (BACKUP_S3_PREFIX= with nothing after the =) means
# "no prefix", which is what a bucket dedicated to these backups wants.
# BACKUP_S3_PREFIX=splitsmart/

# when_required or when_supported. The SDK defaults to when_supported, which
# attaches CRC32 trailers that have historically broken S3-compatible
# providers.
# BACKUP_S3_CHECKSUM_MODE=when_required

# Hour of day, 0-23, at which a day becomes due. UTC ONLY. 0 is midnight UTC.
# BACKUP_HOUR_UTC=0
# Scheduler tick, in minutes (1-1440).
# BACKUP_TICK_MINUTES=15
# Daily copies are kept this many days (today plus the previous N-1). Weekly
# copies — the first successful backup of each ISO week — are never pruned.
# BACKUP_RETENTION_DAYS=7
# Without these a permanently failing backup would retry every tick, each
# attempt vacuuming the whole database.
# BACKUP_MAX_ATTEMPTS_PER_DAY=5
# BACKUP_RETRY_BACKOFF_MINUTES=60
# A run whose heartbeat is older than this is presumed dead and retried.
# BACKUP_STALE_AFTER_MINUTES=15

# Where the temporary VACUUM INTO snapshot is written. Defaults to a
# `backups/` directory next to the database file (./data/backups locally,
# /data/backups in Docker). Must be on the same filesystem as the database.
# BACKUP_TMP_DIR=

# Any AWS_* variable is deliberately NOT read. The SDK's default credential
# chain would pick up a half-set pair and fail at request time instead of
# at parse time.

# Smoke only (yarn smoke:server). Seed runs recurring generation with a pinned
# clock; leave this unset everywhere else.
# DISABLE_RECURRING_SCHEDULER=true
