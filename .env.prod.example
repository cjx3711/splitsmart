# Copy to .env.prod and fill in. Never commit .env.prod.
#
# These are the application secrets for a production deploy. deploy.sh
# validates this file, then copies it to the server as the container's
# --env-file (see scripts/deploy/README.md). It is never baked into the
# Docker image and never committed to git.
#
# Do NOT set these here — they are fixed by the deploy scripts and the
# Dockerfile, and a value in this file would override them:
#   NODE_ENV       always "production" in the image
#   PORT           fixed at 5545 (see .env.deploy for the published host port)
#   DATABASE_PATH  fixed at /data/splitsmart.db, the mounted volume
# deploy.sh refuses to deploy if any of the three are present in this file.

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing this logs everybody out. Required, must be >= 32 characters.
SESSION_SECRET=

# Public origin of the deployed site, no trailing slash. Used to build guest
# links and email links. Required.
APP_ORIGIN=https://your-domain.example

# --- Email ---
# Configure ONE provider. A complete pair is the API credential plus a from
# address. Setting both Resend and Postmark complete pairs is a boot error.
# If neither is set, sending degrades to a log line in `docker logs`; the
# server still boots and the verification link lands there instead of an
# inbox, which is enough to finish signup on a fresh self-hosted instance.

# Resend (https://resend.com): API Keys in the dashboard.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# Postmark: Servers > your server > API Tokens. Leave blank if you use Resend.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_ADDRESS=
POSTMARK_MESSAGE_STREAM=outbound

# When false (default), signup returns the verification URL in the API
# response instead of emailing it. Fine for a single self-hosted user; set to
# true once a mail provider above is actually configured and verified,
# otherwise a broken mail config locks everyone out. Escape hatch if that
# happens: `yarn verify:user -- you@example.com` run on the server.
EMAIL_VERIFICATION_REQUIRED=false

# --- Admin ---
# Comma-separated emails allowed to open /app/admin (usage counts and
# database backups).
# ADMIN_EMAILS=you@example.com

# --- Daily database backup to S3-compatible storage ---
# Defaults to enabled in production. Leave the three required vars unset
# to keep the feature off; a partial set is shown as unconfigured on
# /app/admin/backups and never crashes boot.
# BACKUP_ENABLED=true
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_ENDPOINT=https://t3.storage.dev
# BACKUP_S3_REGION=auto
# BACKUP_S3_PREFIX=splitsmart/
# BACKUP_HOUR_UTC=0
# BACKUP_RETENTION_DAYS=7
# Snapshot directory inside the container. Unset uses /data/backups, next
# to DATABASE_PATH on the mounted volume. update.sh creates that directory.
# BACKUP_TMP_DIR=/data/backups
