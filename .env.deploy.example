# Copy to .env.deploy and fill in. Never commit .env.deploy.
#
# This is deploy-target config (where and how to deploy), kept separate from
# .env.prod (the app's own runtime secrets) so the app's env file never has to
# know the hostname it's being copied to, and this file never has to hold a
# session secret.

# SSH target for the server, e.g. root@your-server.example. Must have
# passwordless (key-based) SSH access; deploy.sh runs several ssh/rsync/scp
# commands against it non-interactively.
DEPLOY_HOST=

# Directory on the server that holds the uploaded image tar, the server-side
# scripts, and (after the first deploy) database_backups/. Created on first
# deploy if missing.
DEPLOY_DIR=/root/projects/splitsmart

# Host directory bind-mounted into the container at /data. This is where the
# SQLite database lives between deploys — it must NOT be shared with another
# app's data directory, and must NOT be deleted between deploys.
DEPLOY_DATA_DIR=/data/splitsmart

# Path to the app's production secrets on the server: root:root, chmod 600,
# passed to the container with `docker run --env-file`. deploy.sh installs
# your local .env.prod here on every deploy. Keep it outside DEPLOY_DIR and
# outside DEPLOY_DATA_DIR — both of those get rsynced/backed up/moved around,
# and a secret living in either would eventually ride along.
DEPLOY_ENV_FILE=/etc/splitsmart/splitsmart.env

# Host port to publish. The container always listens on 5545 internally;
# this is just what's exposed on the server, in case that port is taken by
# something else. Whatever you set it to must also be what your reverse
# proxy (nginx, Caddy, etc.) proxies to.
DEPLOY_PORT=5545

# Public domain this deploys to. Only used to print the URL at the end of a
# deploy and is not sent anywhere — set up DNS and your reverse proxy/TLS
# separately (see scripts/deploy/README.md).
DEPLOY_DOMAIN=
